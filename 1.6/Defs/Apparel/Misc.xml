<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingDef ParentName="Moyo2_ApparelCategory_LightHouse">
		<defName>HOTL_NudibranchSuit</defName>
		<description>A sea slug themed bunny suit designed for the moyo.</description>
		<label>nudibranch suit</label>
		<possessionCount>1</possessionCount>
		<recipeMaker>
			<researchPrerequisite>ComplexClothing</researchPrerequisite>
			<displayPriority>215</displayPriority>
		</recipeMaker>
		<graphicData>
			<texPath>Apparel/NudibranchSuit_Icon</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.05</drawSize>
		</graphicData>
		<costStuffCount>120</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<thingCategories>
			<li>ApparelMisc</li>
		</thingCategories>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToMake>10000</WorkToMake>
			<Mass>2</Mass>
			<StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.60</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.85</StuffEffectMultiplierInsulation_Heat>
			<EquipDelay>3</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<SocialImpact>0.2</SocialImpact>
		</equippedStatOffsets>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Legs</li>
				<li>Feet</li>
			</bodyPartGroups>
			<wornGraphicPath>Apparel/NudibranchSuit</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
			<layers>
				<li>OnSkin</li>
			</layers>
			<tags Inherit="false">
				<!--<li>IndustrialAdvanced</li>-->
			</tags>
			<defaultOutfitTags Inherit="false">
				<!--<li>Worker</li>-->
			</defaultOutfitTags>
			<canBeDesiredForIdeo>false</canBeDesiredForIdeo>
		</apparel>
		<tradeTags>
			<li>BasicClothing</li>
		</tradeTags>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>1</weight>
					<only>(1.0,1.0,1.0)</only>
				</li>
			</options>
		</colorGenerator>
	</ThingDef>


	<ThingDef ParentName="Moyo2_ApparelCategory_LightHouseHead">
		<defName>HOTL_NudibranchEars</defName>
		<label>nudibranch ears</label>
		<description>A set of ears to go with a nudibranch suit.</description>
		<possessionCount>1</possessionCount>
		<recipeMaker>
			<researchPrerequisite>ComplexClothing</researchPrerequisite>
			<displayPriority>100</displayPriority>
		</recipeMaker>
		<graphicData>
			<texPath>Apparel/NudibranchEars_Icon</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(0.9, 0.9)</drawSize>
		</graphicData>
		<costStuffCount>45</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<WorkToMake>1800</WorkToMake>
			<Mass>0.14</Mass>
			<StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.10</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.50</StuffEffectMultiplierInsulation_Heat>
			<EquipDelay>0.8</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<SocialImpact>0.10</SocialImpact>
		</equippedStatOffsets>
		<apparel>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<developmentalStageFilter>Child, Adult</developmentalStageFilter>
			<bodyPartGroups>
				<li>UpperHead</li>
			</bodyPartGroups>
			<wornGraphicPath>Apparel/NudibranchEars</wornGraphicPath>
			<layers>
				<li>Overhead</li>
			</layers>
			<tags Inherit="False">
				<!--<li>IndustrialBasic</li>
				<li>Western</li>-->
			</tags>
			<defaultOutfitTags Inherit="False">
				<!--<li>Worker</li>-->
			</defaultOutfitTags>
		</apparel>
		<tradeTags>
			<li>BasicClothing</li>
		</tradeTags>
		<colorGenerator Class="ColorGenerator_Options">
            <options>
                <li>
                    <weight>1</weight>
                    <only>(1.0,1.0,1.0)</only>
                </li>
            </options>
        </colorGenerator>
	</ThingDef>

</Defs>